<?xml version="1.0" encoding="utf-8"?>
<!-- Gleiche Schlüssel wie values/plurals.xml (ADR-0016). Zahlen sind Kalendertage (ADR-0018). -->
<resources>
    <plurals name="countdown_days_left">
        <item quantity="one">Noch %d Tag</item>
        <item quantity="other">Noch %d Tage</item>
    </plurals>

    <!-- Eine Zeitspanne, z. B. wie lange ein Artikel schon gewünscht ist. -->
    <plurals name="duration_days">
        <item quantity="one">%d Tag</item>
        <item quantity="other">%d Tage</item>
    </plurals>

    <!-- Ab 2 Tagen; 0 und 1 sind relative_today und relative_yesterday. -->
    <plurals name="relative_days_ago">
        <item quantity="one">vor %d Tag</item>
        <item quantity="other">vor %d Tagen</item>
    </plurals>

    <!-- Snackbar nach dem Schnell-Hinzufügen: wie lange der neue Wunsch wartet (seine Wartezeit). -->
    <plurals name="quick_add_saved_want">
        <item quantity="one">Hinzugefügt. Du kannst in %d Tag entscheiden.</item>
        <item quantity="other">Hinzugefügt. Du kannst in %d Tagen entscheiden.</item>
    </plurals>

    <!-- Ein getippter Preis hat mehr Nachkommastellen als die Währung. -->
    <plurals name="quick_add_price_too_many_decimals">
        <item quantity="one">Höchstens %d Nachkommastelle</item>
        <item quantity="other">Höchstens %d Nachkommastellen</item>
    </plurals>

    <!-- Kopf der Artikeldetails: wie lange der Artikel schon gewünscht ist, in Kalendertagen (0 ist item_added_today). -->
    <plurals name="item_wanted_for_days">
        <item quantity="one">Seit %d Tag gewünscht</item>
        <item quantity="other">Seit %d Tagen gewünscht</item>
    </plurals>

    <plurals name="decision_wanted_for_days">
        <item quantity="one">Du willst das seit %d Tag</item>
        <item quantity="other">Du willst das seit %d Tagen</item>
    </plurals>

    <plurals name="decision_others_more">
        <item quantity="one">und %d weiterer Artikel auf deiner Liste</item>
        <item quantity="other">und %d weitere Artikel auf deiner Liste</item>
    </plurals>

    <plurals name="decision_early_days_left">
        <item quantity="one">Noch %d Tag Wartezeit.</item>
        <item quantity="other">Noch %d Tage Wartezeit.</item>
    </plurals>

    <plurals name="decision_wait_days">
        <item quantity="one">In %d Tag</item>
        <item quantity="other">In %d Tagen</item>
    </plurals>

    <plurals name="history_considered_for_days">
        <item quantity="one">%d Tag überlegt</item>
        <item quantity="other">%d Tage überlegt</item>
    </plurals>
</resources>

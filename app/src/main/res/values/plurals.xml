<?xml version="1.0" encoding="utf-8"?>
<!-- Every key also in values-de/plurals.xml (ADR-0016). Counts are calendar days (ADR-0018). -->
<resources>
    <plurals name="countdown_days_left">
        <item quantity="one">%d day left</item>
        <item quantity="other">%d days left</item>
    </plurals>

    <!-- A length of time, e.g. how long an item has been wanted. -->
    <plurals name="duration_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>

    <!-- Used from 2 days on; 0 and 1 are relative_today and relative_yesterday. -->
    <plurals name="relative_days_ago">
        <item quantity="one">%d day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>

    <!-- Snackbar after quick add: how long the new want waits (its cooling-off period). -->
    <plurals name="quick_add_saved_want">
        <item quantity="one">Added. You can decide in %d day.</item>
        <item quantity="other">Added. You can decide in %d days.</item>
    </plurals>

    <!-- A typed price has more decimals than the currency. -->
    <plurals name="quick_add_price_too_many_decimals">
        <item quantity="one">Use at most %d decimal place</item>
        <item quantity="other">Use at most %d decimal places</item>
    </plurals>

    <!-- Item detail header: how long the item has been wanted, in calendar days (0 is item_added_today). -->
    <plurals name="item_wanted_for_days">
        <item quantity="one">Wanted for %d day</item>
        <item quantity="other">Wanted for %d days</item>
    </plurals>

    <!-- Decision screen header: how long the item has been wanted (0 is decision_added_today). -->
    <plurals name="decision_wanted_for_days">
        <item quantity="one">You’ve wanted this for %d day</item>
        <item quantity="other">You’ve wanted this for %d days</item>
    </plurals>

    <!-- "What else this money could do": other items that didn't fit the list. -->
    <plurals name="decision_others_more">
        <item quantity="one">and %d more on your list</item>
        <item quantity="other">and %d more on your list</item>
    </plurals>

    <!-- Early purchase: what's left of the waiting period. -->
    <plurals name="decision_early_days_left">
        <item quantity="one">%d day of the waiting period is left.</item>
        <item quantity="other">%d days of the waiting period are left.</item>
    </plurals>

    <!-- Wait step: one of the fixed options (7, 14, 30 days). -->
    <plurals name="decision_wait_days">
        <item quantity="one">In %d day</item>
        <item quantity="other">In %d days</item>
    </plurals>

    <!-- History: calendar days from adding an item to buying it (0 is history_considered_same_day). -->
    <plurals name="history_considered_for_days">
        <item quantity="one">Considered for %d day</item>
        <item quantity="other">Considered for %d days</item>
    </plurals>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission, ever (ADR-0003). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications (brief §8): asked for once, after the first item is added (Android 13+). The daily check uses
         WorkManager, never exact alarms: no SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM (issue #20). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- localeConfig: the per-app language setting exists from API 33; older versions ignore it, as intended. -->
    <application
        android:name=".BeforeYouBuyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeforeYouBuy"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share capture (#15): text shared from a shop or browser opens quick add over that app. An empty task
             affinity, so a share that starts a new task doesn't bring the app's own task forward, and finishing
             returns to the app the share came from. The share sheet shows the application's label. -->
        <activity
            android:name=".feature.capture.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BeforeYouBuy.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Let it go" on a notification: records the reject without opening the app. Only the app's own pending
             intents reach it. -->
        <receiver
            android:name=".notifications.LetItGoReceiver"
            android:exported="false" />

        <!-- WorkManager starts on demand with the Application's configuration, not at process start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

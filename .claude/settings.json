{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout claude/*)",
      "Bash(git checkout -b claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(./gradlew:*)"
    ],
    "ask": [
      "Bash(git checkout develop)",
      "Bash(git push --force origin claude/*)",
      "Bash(git push --force-with-lease origin claude/*)"
    ],
    "deny": [
      "Bash(git checkout main)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ]
  }
}
